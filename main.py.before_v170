from __future__ import annotations

import csv
from datetime import date
from html import escape
from io import StringIO

import streamlit as st

from odds_browser import fetch_all_trifecta_odds_browser
from probability_model import (
    allocate_bet_budget,
    calculate_expected_values,
    extract_rider_numbers,
)
from racecard_browser import fetch_racecard_data_browser
from lineup_browser import fetch_lineup_browser
from lineup_from_comments import infer_lineup_from_comments
from auto_score import build_automatic_scores
from race_catalog import fetch_race_catalog


st.set_page_config(
    page_title="競輪 妙味期待値アプリ",
    layout="wide",
)

st.title("競輪3連単 妙味期待値アプリ")
st.caption("Ver.1.6.1：AI印表示修正版")


def make_csv(
    rows: list[dict],
    fieldnames: list[str],
) -> bytes:
    buffer = StringIO()

    writer = csv.DictWriter(
        buffer,
        fieldnames=fieldnames,
        extrasaction="ignore",
    )

    writer.writeheader()

    for row in rows:
        writer.writerow(row)

    return buffer.getvalue().encode("utf-8-sig")


def render_odds_table(
    rows: list[dict],
) -> None:
    table_rows = []

    for row in rows:
        table_rows.append(
            f"""
            <tr>
                <td>{escape(str(row.get("人気", "")))}</td>
                <td>{escape(str(row.get("組番", "")))}</td>
                <td>{escape(str(row.get("オッズ", "")))}</td>
            </tr>
            """
        )

    html = f"""
    <div style="max-height:520px;overflow:auto;border:1px solid #ddd;">
        <table style="width:100%;border-collapse:collapse;">
            <thead>
                <tr style="position:sticky;top:0;background:#f5f5f5;">
                    <th style="padding:8px;border-bottom:1px solid #ddd;">人気</th>
                    <th style="padding:8px;border-bottom:1px solid #ddd;">組番</th>
                    <th style="padding:8px;border-bottom:1px solid #ddd;">オッズ</th>
                </tr>
            </thead>
            <tbody>
                {''.join(table_rows)}
            </tbody>
        </table>
    </div>
    """

    st.markdown(
        html,
        unsafe_allow_html=True,
    )


def render_expected_value_table(
    rows: list[dict],
    threshold: float,
) -> None:
    table_rows = []

    for index, row in enumerate(rows, start=1):
        expected_return = float(
            row.get("期待回収率", 0)
        )

        recommendation = (
            "候補"
            if expected_return >= threshold
            else ""
        )

        table_rows.append(
            f"""
            <tr>
                <td>{index}</td>
                <td>{escape(str(row["組番"]))}</td>
                <td>{row["人気"]}</td>
                <td>{row["オッズ"]:.1f}</td>
                <td>{row["モデル確率"] * 100:.3f}%</td>
                <td>{row["市場確率"] * 100:.3f}%</td>
                <td>{row["フェアオッズ"]:.1f}</td>
                <td>{row["期待回収率"]:.3f}</td>
                <td>{row["期待利益率"] * 100:+.1f}%</td>
                <td>{row["妙味倍率"]:.2f}</td>
                <td>{row["参考購入額"]:,}円</td>
                <td>{recommendation}</td>
            </tr>
            """
        )

    html = f"""
    <div style="max-height:700px;overflow:auto;border:1px solid #ddd;">
        <table style="width:100%;border-collapse:collapse;font-size:14px;">
            <thead>
                <tr style="position:sticky;top:0;background:#f5f5f5;">
                    <th>順位</th>
                    <th>組番</th>
                    <th>人気</th>
                    <th>オッズ</th>
                    <th>モデル確率</th>
                    <th>市場確率</th>
                    <th>フェアオッズ</th>
                    <th>期待回収率</th>
                    <th>期待利益率</th>
                    <th>妙味倍率</th>
                    <th>参考購入額</th>
                    <th>判定</th>
                </tr>
            </thead>
            <tbody>
                {''.join(table_rows)}
            </tbody>
        </table>
    </div>
    """

    st.markdown(
        html,
        unsafe_allow_html=True,
    )


defaults = {
    "catalog": {},
    "catalog_logs": [],
    "odds": [],
    "odds_logs": [],
    "expected_values": [],
    "rider_data": [],
    "rider_logs": [],
    "automatic_scores": {},
    "lineup_groups": [],
    "lineup_logs": [],
    "bet_plan": [],
    "bet_plan_message": "",
    "bet_plan_executed": False,
    "bet_plan_candidate_count": 0,
    "plan_minimum_return": 1.00,
    "plan_budget": 10_000,
    "plan_maximum_bets": 10,
    "plan_maximum_ratio": 0.25,
    "plan_minimum_unit": 100,
}

for key, default in defaults.items():
    if key not in st.session_state:
        st.session_state[key] = default


selected_date = st.date_input(
    "開催日",
    value=date.today(),
)

if st.button(
    "この日の開催一覧を取得",
    type="primary",
):
    try:
        with st.spinner(
            "WINTICKETから開催一覧を確認しています"
        ):
            catalog, logs = fetch_race_catalog(
                selected_date
            )

        st.session_state.catalog = catalog
        st.session_state.catalog_logs = logs
        st.session_state.odds = []
        st.session_state.odds_logs = []
        st.session_state.expected_values = []
        st.session_state.rider_data = []
        st.session_state.rider_logs = []
        st.session_state.automatic_scores = {}

    except Exception as exc:
        st.session_state.catalog = {}
        st.session_state.catalog_logs = [
            f"開催一覧取得エラー: "
            f"{type(exc).__name__}: {exc}"
        ]


catalog = st.session_state.catalog

if catalog:
    venue = st.selectbox(
        "競輪場",
        list(catalog.keys()),
    )

    races = catalog[venue]

    race_labels = [
        f"{race['race_number']}R"
        for race in races
    ]

    selected_label = st.selectbox(
        "レース番号",
        race_labels,
    )

    selected_race = races[
        race_labels.index(selected_label)
    ]

    st.success(
        f"選択中：{selected_date:%Y年%m月%d日}"
        f"・{venue}・{selected_label}"
    )

    st.code(
        selected_race["url"],
        language=None,
    )

    if st.button(
        "3連単オッズを取得",
        type="primary",
    ):
        st.session_state.rider_data = []
        st.session_state.rider_logs = []
        st.session_state.automatic_scores = {}
        try:
            with st.spinner(
                "全3連単オッズを取得しています"
            ):
                odds, logs = (
                    fetch_all_trifecta_odds_browser(
                        selected_race["url"]
                    )
                )

            st.session_state.odds = odds
            st.session_state.odds_logs = logs
            st.session_state.expected_values = []

            rider_data, rider_logs = (
                fetch_racecard_data_browser(
                    selected_race["url"]
                )
            )

            st.session_state.rider_data = rider_data
            st.session_state.rider_logs = rider_logs
            st.session_state.automatic_scores = (
                build_automatic_scores(
                    rider_data
                )
            )

            rider_numbers_for_lineup = sorted(
                int(item["車番"])
                for item in rider_data
                if item.get("車番") is not None
            )

            dom_lineup_groups, dom_lineup_logs = (
                fetch_lineup_browser(
                    selected_race["url"],
                    rider_numbers_for_lineup,
                )
            )

            comment_lineup_groups, comment_lineup_logs = (
                infer_lineup_from_comments(
                    rider_data
                )
            )

            # コメントから2車以上のラインを取得できた場合は
            # DOMの数字列解析より優先する。
            meaningful_comment_groups = [
                group
                for group in comment_lineup_groups
                if len(group) >= 2
            ]

            if meaningful_comment_groups:
                lineup_groups = comment_lineup_groups
                lineup_logs = (
                    dom_lineup_logs
                    + comment_lineup_logs
                    + ["採用並び: コメント解析"]
                )
            else:
                lineup_groups = dom_lineup_groups
                lineup_logs = (
                    dom_lineup_logs
                    + comment_lineup_logs
                    + ["採用並び: DOM解析"]
                )

            st.session_state.lineup_groups = lineup_groups
            st.session_state.lineup_logs = lineup_logs

        except Exception as exc:
            st.session_state.odds = []
            st.session_state.odds_logs = [
                f"オッズ取得エラー: "
                f"{type(exc).__name__}: {exc}"
            ]


odds = st.session_state.odds

if odds:
    st.divider()
    st.subheader("取得オッズ")

    st.success(
        f"3連単オッズを{len(odds)}件取得しました。"
    )

    render_odds_table(odds)

    st.download_button(
        "オッズCSVをダウンロード",
        data=make_csv(
            odds,
            ["人気", "組番", "オッズ"],
        ),
        file_name=(
            f"{selected_date:%Y%m%d}_"
            f"{venue}_{selected_label}_"
            "trifecta_odds.csv"
        ),
        mime="text/csv",
    )

    st.divider()
    st.subheader("選手評価と期待値設定")

    riders = extract_rider_numbers(odds)

    st.write(
        "各選手を100点満点の目安で評価してください。"
        "絶対値より、選手間の点差が重要です。"
    )

    score_columns = st.columns(
        min(len(riders), 9)
    )

    scores: dict[int, float] = {}

    for index, rider in enumerate(riders):
        with score_columns[index % len(score_columns)]:
            rider_information = next(
                (
                    item
                    for item in st.session_state.rider_data
                    if int(item.get("車番", 0)) == rider
                ),
                {},
            )

            rider_name = rider_information.get(
                "選手名",
                "",
            )

            automatic_value = float(
                st.session_state.automatic_scores.get(
                    rider,
                    50.0,
                )
            )

            label = (
                f"{rider}番車 {rider_name}"
                if rider_name
                else f"{rider}番車"
            )

            scores[rider] = st.number_input(
                label,
                min_value=0.0,
                max_value=100.0,
                value=automatic_value,
                step=0.5,
                key=f"score_{rider}",
            )

            details = []

            for key in (
                "AI印",
                "競走得点",
                "脚質",
                "B",
                "H",
                "S",
            ):
                value = rider_information.get(key)

                if value not in (None, ""):
                    details.append(
                        f"{key}:{value}"
                    )

            if details:
                st.caption(
                    " / ".join(details)
                )

    settings_left, settings_middle, settings_right = (
        st.columns(3)
    )

    with settings_left:
        temperature = st.number_input(
            "確率の平準化",
            min_value=0.1,
            max_value=20.0,
            value=5.0,
            step=0.1,
            help=(
                "小さいほど高評価選手を強く信頼し、"
                "大きいほど確率差を小さくします。"
            ),
        )

    with settings_middle:
        minimum_expected_return = st.number_input(
            "最低期待回収率",
            min_value=0.5,
            max_value=5.0,
            value=1.10,
            step=0.05,
        )

    with settings_right:
        bankroll = st.number_input(
            "参考資金",
            min_value=1_000,
            max_value=10_000_000,
            value=int(
                st.session_state.get(
                    "plan_budget",
                    10_000,
                )
            ),
            step=1_000,
            key="plan_budget",
        )

    st.markdown("#### 着順別ライン確率補正")

    use_sequence_adjustment = st.checkbox(
        "3連単の着順へライン補正を使用する",
        value=True,
        help=(
            "同ラインの先頭・番手・3番手が"
            "連続して入着する組番を相対的に加点します。"
        ),
    )

    sequence_col1, sequence_col2 = st.columns(2)
    sequence_col3, sequence_col4 = st.columns(2)

    with sequence_col1:
        line_exact_bonus = st.number_input(
            "ライン順完全一致倍率",
            min_value=0.50,
            max_value=3.00,
            value=1.30,
            step=0.05,
            help="例：7-4-1ラインで7-4-1決着",
        )

    with sequence_col2:
        line_pair_bonus = st.number_input(
            "先頭・番手連携倍率",
            min_value=0.50,
            max_value=2.00,
            value=1.12,
            step=0.02,
        )

    with sequence_col3:
        second_over_leader_bonus = st.number_input(
            "番手差し倍率",
            min_value=0.50,
            max_value=2.00,
            value=1.15,
            step=0.05,
            help="例：7-4ラインで4-7決着",
        )

    with sequence_col4:
        second_third_bonus = st.number_input(
            "番手・3番手連携倍率",
            min_value=0.50,
            max_value=2.00,
            value=1.08,
            step=0.02,
        )

    kelly_fraction = st.slider(
        "ケリー基準の使用割合",
        min_value=0.0,
        max_value=1.0,
        value=0.25,
        step=0.05,
        help=(
            "1.0はフルケリー、0.25は4分の1ケリーです。"
        ),
    )

    if st.button(
        "妙味期待値を計算",
        type="primary",
    ):
        lineup_groups = st.session_state.get(
            "lineup_groups",
            [],
        )

        results = calculate_expected_values(
            odds,
            scores=scores,
            temperature=temperature,
            bankroll=int(bankroll),
            kelly_fraction=kelly_fraction,
            lineup_groups=lineup_groups,
            use_sequence_adjustment=(
                use_sequence_adjustment
            ),
            line_exact_bonus=line_exact_bonus,
            line_pair_bonus=line_pair_bonus,
            second_over_leader_bonus=(
                second_over_leader_bonus
            ),
            second_third_bonus=(
                second_third_bonus
            ),
        )

        st.session_state.expected_values = results
        st.session_state.bet_plan = []
        st.session_state.bet_plan_executed = False
        st.session_state.bet_plan_message = ""
        st.session_state.bet_plan_candidate_count = 0


expected_values = st.session_state.expected_values

if expected_values:
    st.divider()
    st.subheader("妙味期待値ランキング")

    filtered_results = [
        row
        for row in expected_values
        if row["期待回収率"]
        >= minimum_expected_return
    ]

    display_count = st.slider(
        "表示件数",
        min_value=5,
        max_value=min(
            100,
            len(expected_values),
        ),
        value=min(
            30,
            len(expected_values),
        ),
        step=5,
    )

    if filtered_results:
        st.success(
            f"最低期待回収率"
            f"{minimum_expected_return:.2f}以上："
            f"{len(filtered_results)}件"
        )
    else:
        st.warning(
            "設定した最低期待回収率を超える"
            "買い目はありません。"
        )

    render_expected_value_table(
        expected_values[:display_count],
        threshold=minimum_expected_return,
    )

    export_rows = []

    for row in expected_values:
        export_rows.append(
            {
                "人気": row["人気"],
                "組番": row["組番"],
                "オッズ": round(row["オッズ"], 3),
                "モデル確率": round(
                    row["モデル確率"],
                    8,
                ),
                "市場確率": round(
                    row["市場確率"],
                    8,
                ),
                "フェアオッズ": round(
                    row["フェアオッズ"],
                    3,
                ),
                "期待回収率": round(
                    row["期待回収率"],
                    4,
                ),
                "期待利益率": round(
                    row["期待利益率"],
                    4,
                ),
                "妙味倍率": round(
                    row["妙味倍率"],
                    4,
                ),
                "参考購入額": row["参考購入額"],
            }
        )

    st.divider()
    st.subheader("予算別・買い目自動配分")

    allocation_col1, allocation_col2 = st.columns(2)
    allocation_col3, allocation_col4 = st.columns(2)

    with allocation_col1:
        betting_budget = st.number_input(
            "今回の購入予算",
            min_value=100,
            max_value=10_000_000,
            value=10_000,
            step=1_000,
        )

    with allocation_col2:
        maximum_bets = st.number_input(
            "最大買い目数",
            min_value=1,
            max_value=50,
            value=int(
                st.session_state.get(
                    "plan_maximum_bets",
                    10,
                )
            ),
            step=1,
            key="plan_maximum_bets",
        )

    with allocation_col3:
        maximum_bet_ratio = st.slider(
            "1点あたり最大予算比率",
            min_value=0.05,
            max_value=1.00,
            value=float(
                st.session_state.get(
                    "plan_maximum_ratio",
                    0.25,
                )
            ),
            step=0.05,
            key="plan_maximum_ratio",
        )

    with allocation_col4:
        minimum_unit = st.selectbox(
            "購入単位",
            options=[100, 200, 500, 1000],
            index=0,
            format_func=lambda value: f"{value:,}円",
        )

    qualifying_rows = [
        row
        for row in expected_values
        if float(row.get("期待回収率", 0))
        >= float(minimum_expected_return)
    ]

    positive_kelly_rows = [
        row
        for row in qualifying_rows
        if float(row.get("モデル確率", 0))
        * float(row.get("オッズ", 0)) > 1.0
    ]

    diagnostic_col1, diagnostic_col2 = st.columns(2)

    with diagnostic_col1:
        st.metric(
            "最低期待回収率以上",
            f"{len(qualifying_rows)}件",
        )

    with diagnostic_col2:
        st.metric(
            "配分候補",
            f"{len(positive_kelly_rows)}件",
        )

    if st.button(
        "期待値計算から買い目作成まで一括実行",
        type="primary",
    ):
        lineup_groups_for_plan = (
            st.session_state.get(
                "lineup_groups",
                [],
            )
        )

        calculated_results = (
            calculate_expected_values(
                odds,
                scores=scores,
                temperature=temperature,
                bankroll=int(bankroll),
                kelly_fraction=kelly_fraction,
                lineup_groups=(
                    lineup_groups_for_plan
                ),
                use_sequence_adjustment=(
                    use_sequence_adjustment
                ),
                line_exact_bonus=(
                    line_exact_bonus
                ),
                line_pair_bonus=(
                    line_pair_bonus
                ),
                second_over_leader_bonus=(
                    second_over_leader_bonus
                ),
                second_third_bonus=(
                    second_third_bonus
                ),
            )
        )

        st.session_state.expected_values = (
            calculated_results
        )

        generated_plan = allocate_bet_budget(
            calculated_results,
            budget=int(betting_budget),
            minimum_expected_return=float(
                minimum_expected_return
            ),
            maximum_bets=int(maximum_bets),
            minimum_unit=int(minimum_unit),
            maximum_bet_ratio=float(
                maximum_bet_ratio
            ),
        )

        st.session_state.bet_plan = generated_plan
        st.session_state.bet_plan_executed = True
        st.session_state.bet_plan_candidate_count = len(
            generated_plan
        )

        if generated_plan:
            st.session_state.bet_plan_message = (
                f"{len(generated_plan)}点の"
                "買い目プランを作成しました。"
            )
            st.success(
                st.session_state.bet_plan_message
            )
            st.rerun()
        else:
            st.session_state.bet_plan_message = (
                "現在の設定では購入対象が"
                "見つかりませんでした。"
            )
            st.warning(
                st.session_state.bet_plan_message
            )
            st.rerun()

    if st.button(
        "予算から買い目を自動配分",
    ):
        generated_plan = allocate_bet_budget(
            expected_values,
            budget=int(betting_budget),
            minimum_expected_return=(
                minimum_expected_return
            ),
            maximum_bets=int(maximum_bets),
            minimum_unit=int(minimum_unit),
            maximum_bet_ratio=(
                maximum_bet_ratio
            ),
        )

        st.session_state.bet_plan = generated_plan
        st.session_state.bet_plan_executed = True
        st.session_state.bet_plan_candidate_count = len(
            positive_kelly_rows
        )

        if not generated_plan:
            if not qualifying_rows:
                st.session_state.bet_plan_message = (
                    "買い目候補は0件です。"
                    "最低期待回収率を満たす組番がありません。"
                )
            elif not positive_kelly_rows:
                st.session_state.bet_plan_message = (
                    "買い目候補は0件です。"
                    "期待回収率の条件を満たしていても、"
                    "ケリー基準がプラスの組番がありません。"
                )
            else:
                st.session_state.bet_plan_message = (
                    "買い目候補は0件です。"
                    "購入単位、予算、1点上限の設定により"
                    "配分できませんでした。"
                )
        else:
            st.session_state.bet_plan_message = (
                f"買い目候補は{len(generated_plan)}件です。"
            )

        st.rerun()

    bet_plan = st.session_state.get(
        "bet_plan",
        [],
    )

    if bet_plan:
        st.success(
            st.session_state.get(
                "bet_plan_message",
                f"{len(bet_plan)}点の買い目プランを表示します。",
            )
        )

        st.markdown("### 作成された買い目プラン")

        total_purchase = sum(
            int(row["購入額"])
            for row in bet_plan
        )

        total_expected_return = sum(
            float(row["期待払戻"])
            for row in bet_plan
        )

        total_expected_profit = sum(
            float(row["期待利益"])
            for row in bet_plan
        )

        summary_col1, summary_col2, summary_col3 = (
            st.columns(3)
        )

        with summary_col1:
            st.metric(
                "合計購入額",
                f"{total_purchase:,}円",
            )

        with summary_col2:
            st.metric(
                "期待払戻額",
                f"{total_expected_return:,.0f}円",
            )

        with summary_col3:
            st.metric(
                "期待利益",
                f"{total_expected_profit:+,.0f}円",
            )

        plan_table_rows = []

        for index, row in enumerate(
            bet_plan,
            start=1,
        ):
            plan_table_rows.append(
                {
                    "順位": index,
                    "組番": str(row["組番"]),
                    "人気": int(row["人気"]),
                    "オッズ": round(
                        float(row["オッズ"]),
                        1,
                    ),
                    "モデル確率": (
                        f"{float(row['モデル確率']) * 100:.3f}%"
                    ),
                    "期待回収率": round(
                        float(row["期待回収率"]),
                        3,
                    ),
                    "購入額": (
                        f"{int(row['購入額']):,}円"
                    ),
                    "的中時払戻": (
                        f"{int(row['的中時払戻']):,}円"
                    ),
                    "期待利益": (
                        f"{float(row['期待利益']):+,.0f}円"
                    ),
                    "予算比率": (
                        f"{float(row['予算比率']) * 100:.1f}%"
                    ),
                }
            )

        st.dataframe(
            plan_table_rows,
            use_container_width=True,
            hide_index=True,
        )

        bet_export_rows = []

        for row in bet_plan:
            bet_export_rows.append(
                {
                    "組番": row["組番"],
                    "人気": row["人気"],
                    "オッズ": row["オッズ"],
                    "モデル確率": round(
                        row["モデル確率"],
                        8,
                    ),
                    "期待回収率": round(
                        row["期待回収率"],
                        4,
                    ),
                    "購入額": row["購入額"],
                    "的中時払戻": row["的中時払戻"],
                    "期待払戻": row["期待払戻"],
                    "期待利益": row["期待利益"],
                    "予算比率": round(
                        row["予算比率"],
                        4,
                    ),
                }
            )

        st.download_button(
            "買い目プランCSVをダウンロード",
            data=make_csv(
                bet_export_rows,
                [
                    "組番",
                    "人気",
                    "オッズ",
                    "モデル確率",
                    "期待回収率",
                    "購入額",
                    "的中時払戻",
                    "期待払戻",
                    "期待利益",
                    "予算比率",
                ],
            ),
            file_name=(
                f"{selected_date:%Y%m%d}_"
                f"{venue}_{selected_label}_"
                "bet_plan.csv"
            ),
            mime="text/csv",
        )

    else:
        plan_executed = st.session_state.get(
            "bet_plan_executed",
            False,
        )

        plan_message = st.session_state.get(
            "bet_plan_message",
            "",
        )

        if plan_executed:
            st.error(
                plan_message
                or "買い目候補は0件です。"
            )

            st.markdown("### 買い目プラン：0件")

            reason_rows = []

            if len(qualifying_rows) == 0:
                reason_rows.append(
                    "最低期待回収率以上の組番が0件"
                )

            if len(positive_kelly_rows) == 0:
                reason_rows.append(
                    "ケリー基準がプラスの組番が0件"
                )

            if int(betting_budget) < int(minimum_unit):
                reason_rows.append(
                    "購入予算が購入単位を下回っています"
                )

            if reason_rows:
                st.write("作成できなかった理由：")

                for reason in reason_rows:
                    st.write(f"・{reason}")

            st.info(
                "動作確認では最低期待回収率を1.00、"
                "購入予算を10,000円、購入単位を100円に"
                "設定してください。"
            )

        else:
            st.info(
                "まだ買い目プランを作成していません。"
                "設定後に「予算から買い目を自動配分」を"
                "押してください。"
            )

    st.download_button(
        "期待値CSVをダウンロード",
        data=make_csv(
            export_rows,
            [
                "人気",
                "組番",
                "オッズ",
                "モデル確率",
                "市場確率",
                "フェアオッズ",
                "期待回収率",
                "期待利益率",
                "妙味倍率",
                "参考購入額",
            ],
        ),
        file_name=(
            f"{selected_date:%Y%m%d}_"
            f"{venue}_{selected_label}_"
            "expected_values.csv"
        ),
        mime="text/csv",
    )

    with st.expander("期待値の計算方法"):
        st.write(
            "期待回収率 ＝ モデル的中確率 × オッズ"
        )
        st.write(
            "妙味倍率 ＝ モデル的中確率 ÷ 市場確率"
        )
        st.write(
            "フェアオッズ ＝ 1 ÷ モデル的中確率"
        )
        st.warning(
            "評価点と確率モデルに基づく推定値であり、"
            "利益や的中を保証するものではありません。"
        )


with st.expander("取得ログ・自己診断"):
    logs = (
        st.session_state.catalog_logs
        + st.session_state.odds_logs
        + st.session_state.rider_logs
        + st.session_state.lineup_logs
    )

    st.code(
        "\n".join(logs)
        if logs
        else "まだ取得を実行していません。",
        language=None,
    )
